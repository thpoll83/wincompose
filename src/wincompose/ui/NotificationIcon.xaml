<tb:TaskbarIcon x:Class="WinCompose.NotificationIcon"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:tb="http://www.hardcodet.net/taskbar"
                xmlns:wc="clr-namespace:WinCompose"
                xmlns:i18n="clr-namespace:WinCompose.i18n;assembly=language"
                DataContext="{Binding RelativeSource={RelativeSource Self}}"
                x:Name="wcToolTip"
                IconSource="/ui/key_compose.png"
                ToolTipText="{Binding CurrentToolTip}">

    <tb:TaskbarIcon.Resources>
        <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter"/>
        <BitmapImage x:Key="ComposeKeyImage" UriSource="../res/key_compose.png"/>
        <!-- Pre-rendered rather than drawn by Emoji.Wpf. These four icons were
             the only emoji on the startup path, and drawing them cost ~41 MB of
             managed heap for the entire session: the library parses the emoji
             font to render them and never releases it. Measured on three
             machines, live heap settled at 54.1 MB and did not move again, of
             which 7.9 MB is the compose data and ~5 MB is WPF.

             The windows that show user content keep using Emoji.Wpf -- there
             rendering arbitrary emoji is the whole point, and the cost is only
             paid if the user opens one.

             Rendered by src/render-menu-icons.py from NotoColorEmoji at 72px,
             four times the height the menu draws, so they stay crisp at high
             DPI. Re-run it rather than editing the PNGs by hand. -->
        <Image Height="18" x:Key="SequencesEmoji" Source="../res/menu/sequences.png"/>
        <Image Height="18" x:Key="OptionsEmoji"   Source="../res/menu/options.png"/>
        <Image Height="18" x:Key="DebugEmoji"     Source="../res/menu/debug.png"/>
        <Image Height="18" x:Key="ExitEmoji"      Source="../res/menu/exit.png"/>
    </tb:TaskbarIcon.Resources>

    <tb:TaskbarIcon.ContextMenu>
        <ContextMenu Padding="0,0,0,1">

            <ContextMenu.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <!-- Enforce Aero style for this specific context menu. -->
                        <!--<ResourceDictionary Source="/PresentationFramework.Aero;component/themes/Aero.NormalColor.xaml"/>-->
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </ContextMenu.Resources>

            <MenuItem Height="32" IsEnabled="False" Padding="0,0,0,2">
                <MenuItem.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="LightCyan" Offset="0"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </MenuItem.Background>
                <MenuItem.Icon>
                    <Image Source="{StaticResource ComposeKeyImage}" Width="16" Height="16"/>
                </MenuItem.Icon>
                <MenuItem.Header>
                    <TextBlock Text="WinCompose" VerticalAlignment="Center"/>
                </MenuItem.Header>
            </MenuItem>

            <MenuItem Command="{Binding MenuItemCommand}"
                      Icon="{StaticResource SequencesEmoji}" CommandParameter="{x:Static wc:MenuCommand.ShowSequences}">
                <MenuItem.Header>
                    <TextBlock Text="{x:Static i18n:Text.ShowSequences}"/>
                </MenuItem.Header>
            </MenuItem>

            <MenuItem Header="{x:Static i18n:Text.ShowOptions}" Command="{Binding MenuItemCommand}"
                      Icon="{StaticResource OptionsEmoji}" CommandParameter="{x:Static wc:MenuCommand.ShowOptions}"/>

            <!-- About, the website and the donation page all live in the options
                 dialog now, so the tray menu is one flat list of actions. -->
            <MenuItem Header="{x:Static i18n:Text.DebugWindow}" Command="{Binding MenuItemCommand}"
                      Icon="{StaticResource DebugEmoji}" CommandParameter="{x:Static wc:MenuCommand.DebugWindow}"/>

            <MenuItem Command="{Binding MenuItemCommand}"
                      Visibility="{Binding Path=HasNewerVersion, Mode=OneWay, Converter={StaticResource booleanToVisibilityConverter}}"
                      CommandParameter="{x:Static wc:MenuCommand.Download}">
                <MenuItem.Header>
                    <TextBlock Text="{Binding DownloadHeader}"/>
                </MenuItem.Header>
            </MenuItem>

            <Separator/>

            <MenuItem Header="{x:Static i18n:Text.Exit}" Command="{Binding MenuItemCommand}"
                      Icon="{StaticResource ExitEmoji}" CommandParameter="{x:Static wc:MenuCommand.Exit}"/>

        </ContextMenu>
    </tb:TaskbarIcon.ContextMenu>

</tb:TaskbarIcon>

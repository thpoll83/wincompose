<Project Sdk="Microsoft.NET.Sdk">

  <!-- Converted from the legacy project format. The old one resolved MSTest
       through a bare <Reference> to Microsoft.VisualStudio.QualityTools.
       UnitTestFramework, which only exists inside a Visual Studio install and
       so could not be built by CI. The packages below resolve from NuGet. -->

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <RootNamespace>WinCompose</RootNamespace>
    <AssemblyName>tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Properties/AssemblyInfo.cs is checked in and still declares these
         attributes; letting the SDK generate its own as well makes every one
         of them a duplicate (CS0579). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\wincompose\wincompose.csproj" />
  </ItemGroup>

</Project>
